{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cybersecurity-academy:curriculum-manifest:1.0.0",
  "title": "Cybersecurity Master Academy curriculum manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "curriculum_version",
    "updated",
    "status",
    "description",
    "source_ledger",
    "level_definitions",
    "paths",
    "modules"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "curriculum_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "updated": { "type": "string", "format": "date" },
    "status": { "enum": ["draft", "review", "stable", "deprecated"] },
    "description": { "type": "string", "minLength": 10 },
    "source_ledger": { "type": "string", "minLength": 1 },
    "level_definitions": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "exit_criterion"],
        "properties": {
          "id": { "enum": ["L0", "L1", "L2", "L3", "L4", "L5"] },
          "name": { "type": "string", "minLength": 3 },
          "exit_criterion": { "type": "string", "minLength": 10 }
        }
      }
    },
    "paths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "capstone", "focus", "module_count", "modules"],
        "properties": {
          "id": { "type": "string", "pattern": "^PATH-[A-Z0-9-]+$" },
          "name": { "type": "string", "minLength": 3 },
          "capstone": { "type": "string", "pattern": "^[A-Z][A-Z0-9]{1,3}-[0-9]{2}$" },
          "focus": { "type": "string", "minLength": 10 },
          "module_count": { "type": "integer", "minimum": 1 },
          "modules": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9]{1,3}-[0-9]{2}$" }
          }
        }
      }
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id", "title", "level", "type", "tracks", "status", "validation_status",
          "prerequisites", "prerequisite_note", "effort_hours", "outcomes",
          "assessment", "sources", "safety", "artifacts", "last_reviewed", "reviewer"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Z][A-Z0-9]{1,3}-[0-9]{2}$" },
          "title": { "type": "string", "minLength": 3 },
          "level": { "enum": ["L0", "L1", "L2", "L3", "L4", "L5"] },
          "type": { "enum": ["module", "elective", "capstone"] },
          "tracks": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 2 }
          },
          "status": { "enum": ["planned", "drafted", "reviewed", "lab_validated", "published", "deprecated"] },
          "validation_status": { "enum": ["unvalidated", "structural", "technical", "safety_reviewed", "peer_reviewed", "classroom_tested"] },
          "prerequisites": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9]{1,3}-[0-9]{2}$" }
          },
          "prerequisite_note": { "type": ["string", "null"] },
          "effort_hours": {
            "type": "object",
            "additionalProperties": false,
            "required": ["reading", "practice", "assessment", "total"],
            "properties": {
              "reading": { "type": "integer", "minimum": 0 },
              "practice": { "type": "integer", "minimum": 0 },
              "assessment": { "type": "integer", "minimum": 0 },
              "total": { "type": "integer", "minimum": 1 }
            }
          },
          "outcomes": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "statement"],
              "properties": {
                "id": { "type": "string", "pattern": "^[A-Z][A-Z0-9]{1,3}-[0-9]{2}\\.O[0-9]+$" },
                "statement": { "type": "string", "minLength": 20 }
              }
            }
          },
          "assessment": { "type": "string", "minLength": 3 },
          "sources": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[A-Z][0-9]{2}$" }
          },
          "safety": {
            "type": "object",
            "additionalProperties": false,
            "required": ["isolation", "risk"],
            "properties": {
              "isolation": { "enum": ["none", "recommended", "required"] },
              "risk": { "enum": ["low", "moderate", "high"] }
            }
          },
          "artifacts": {
            "type": "object",
            "additionalProperties": false,
            "required": ["docs", "labs", "assessments"],
            "properties": {
              "docs": { "type": "array", "items": { "type": "string" } },
              "labs": { "type": "array", "items": { "type": "string" } },
              "assessments": { "type": "array", "items": { "type": "string" } }
            }
          },
          "last_reviewed": { "type": ["string", "null"], "format": "date" },
          "reviewer": { "type": ["string", "null"] }
        }
      }
    }
  }
}
