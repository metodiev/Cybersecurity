# Optional syscall-tracing environment. Namespace experiments may require a VM.
# Build from the lab root:
#   docker build -f environment/Containerfile -t sys02-lab:local .
# The base tag is not digest-pinned; record the image ID after building.
# The default user is the non-root labuser (UID 1000).
FROM debian:bookworm-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      build-essential \
      ca-certificates \
      iproute2 \
      libcap2-bin \
      passwd \
      python3 \
      strace \
      util-linux \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /lab
COPY starter/ /lab/starter/
COPY scripts/ /lab/scripts/
RUN useradd --create-home --uid 1000 --shell /bin/bash labuser \
 && mkdir -p /lab/evidence \
 && chown -R labuser:labuser /lab
USER labuser
